{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exp3c1-leaderboard-entry",
  "title": "Future Paper 3 leaderboard row",
  "description": "Schema only. The registry ships no result rows and does not rank them.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "entry_id",
    "system_id",
    "system_version",
    "checkpoint_id",
    "checkpoint_revision",
    "regime",
    "dataset_id",
    "dataset_version",
    "split",
    "reference_ontology",
    "prediction_ontology",
    "ontology_alignment",
    "language",
    "task",
    "program",
    "protocol_id",
    "evaluator",
    "evaluator_version",
    "evaluator_config",
    "eligibility_policy",
    "matching",
    "normalization",
    "context",
    "estimand",
    "predictions_sha256",
    "gold_sha256",
    "coverage",
    "states",
    "diagnostics",
    "metrics",
    "provenance",
    "reproduction_status",
    "publication_status",
    "comparability"
  ],
  "properties": {
    "entry_id": {"type": "string"},
    "system_id": {"type": "string"},
    "system_version": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "checkpoint_revision": {"type": "string"},
    "regime": {"type": "string"},
    "dataset_id": {"type": "string"},
    "dataset_version": {"type": "string"},
    "split": {"type": "string"},
    "reference_ontology": {"type": "string"},
    "prediction_ontology": {"type": "string"},
    "ontology_alignment": {"type": "string"},
    "language": {"type": "string"},
    "task": {"type": "string"},
    "program": {"type": "string", "enum": ["SOTA", "CONDITIONING"]},
    "protocol_id": {"type": "string"},
    "evaluator": {"type": "string"},
    "evaluator_version": {"type": "string"},
    "evaluator_config": {"type": "object"},
    "eligibility_policy": {"type": "string"},
    "matching": {"type": "string"},
    "normalization": {"type": "string"},
    "context": {"type": "string"},
    "estimand": {"type": "string"},
    "predictions_sha256": {"type": ["string", "null"]},
    "gold_sha256": {"type": ["string", "null"]},
    "coverage": {"type": "object"},
    "states": {"type": "object"},
    "diagnostics": {"type": "object"},
    "metrics": {"type": ["object", "null"]},
    "provenance": {"type": "object"},
    "reproduction_status": {"type": "string"},
    "publication_status": {"type": "string"},
    "comparability": {
      "type": "string",
      "enum": ["scientific_comparable", "diagnostic_only", "not_comparable"]
    }
  }
}
