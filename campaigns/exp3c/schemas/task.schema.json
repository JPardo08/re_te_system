{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exp3c1-task",
  "title": "Paper 3 campaign-registry task",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "program",
    "system_id",
    "dataset_id",
    "split",
    "condition",
    "protocol_id",
    "summary",
    "inputs",
    "outputs",
    "dependencies",
    "resource_profile_id",
    "resources",
    "executor",
    "gates",
    "acceptance_criteria",
    "preparation_status",
    "authorization",
    "technical_block",
    "block_reasons",
    "training",
    "included_in_submit_all",
    "evaluation",
    "retry_policy",
    "execution_permitted",
    "leaderboard_class",
    "requires_checkpoint_identity",
    "requires_tokenizer",
    "requires_real_preflight",
    "real_preflight_done",
    "requires_no_truncation",
    "requires_frozen_output_budget",
    "output_budget_frozen",
    "requires_channel_separator"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "program": {"type": "string", "enum": ["SOTA", "CONDITIONING"]},
    "system_id": {"type": ["string", "null"]},
    "dataset_id": {"type": ["string", "null"]},
    "split": {"type": ["string", "null"]},
    "condition": {"type": ["string", "null"]},
    "protocol_id": {"type": ["string", "null"]},
    "summary": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "resource_profile_id": {"type": "string"},
    "resources": {
      "type": "object",
      "required": ["process_ram", "vram"],
      "properties": {
        "process_ram": {"type": ["string", "null"]},
        "vram": {"type": "null"}
      }
    },
    "executor": {
      "type": "object",
      "required": ["kind", "path", "invoked_by"],
      "properties": {
        "kind": {"type": "string", "enum": ["existing_sbatch", "not_versioned", "none"]},
        "path": {"type": ["string", "null"]},
        "invoked_by": {"type": ["string", "null"]}
      }
    },
    "gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preparation_status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "PREPARED",
        "BLOCKED",
        "AWAITING_RESOURCES",
        "AWAITING_AUTHORIZATION",
        "RUNNING",
        "VALIDATED",
        "FAILED"
      ]
    },
    "authorization": {"type": "string", "enum": ["not_authorized", "authorized"]},
    "technical_block": {"type": "boolean"},
    "block_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "evidence"],
        "properties": {
          "code": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "training": {"type": "boolean"},
    "included_in_submit_all": {"type": "boolean"},
    "evaluation": {"type": ["object", "null"]},
    "retry_policy": {"type": "string"},
    "execution_permitted": {"type": "boolean"},
    "leaderboard_class": {
      "type": ["string", "null"],
      "enum": ["scientific_comparable", "diagnostic_only", "not_comparable", null]
    },
    "requires_checkpoint_identity": {"type": "boolean"},
    "requires_tokenizer": {"type": "boolean"},
    "requires_real_preflight": {"type": "boolean"},
    "real_preflight_done": {"type": "boolean"},
    "requires_no_truncation": {"type": "boolean"},
    "requires_frozen_output_budget": {"type": "boolean"},
    "output_budget_frozen": {"type": "boolean"},
    "requires_channel_separator": {"type": "boolean"}
  }
}
